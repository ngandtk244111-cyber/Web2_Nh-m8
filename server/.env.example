# Copy this file to .env and fill in real values before running the server.

PORT=4300
MONGODB_URI=mongodb://127.0.0.1:27017/deco3d

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# OTP dev mode: when true, verify-otp accepts the code returned by request-otp's
# devOtp field instead of sending a real SMS. Turn off once a real SMS provider
# is wired into utils/sms.js.
OTP_DEV_MODE=true

# Google OAuth Client ID (Web application) from Google Cloud Console — used to verify
# Google Identity Services ID tokens server-side. No client secret needed for this flow.
# Must match the googleClientId set in the frontend's environment.ts/environment.prod.ts.
GOOGLE_CLIENT_ID=

# MoMo sandbox (public test credentials from https://developers.momo.vn/v3/docs/payment/onboarding/test-instructions/)
MOMO_PARTNER_CODE=MOMOBKUN20180529
