# Copy this file to .env and fill in real values before running the server.

PORT=4300
MONGODB_URI=mongodb://127.0.0.1:27017/deco3d

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# OTP dev mode: when true, verify-otp accepts the code returned by request-otp's
# devOtp field instead of sending a real SMS. Turn off once a real SMS provider
# is wired into utils/sms.js.
OTP_DEV_MODE=true

# ===== Gửi mã OTP thật =====
# Email (Gmail): bật Xác minh 2 bước cho Gmail, rồi tạo "Mật khẩu ứng dụng" tại
# https://myaccount.google.com/apppasswords — dán 16 ký tự (bỏ dấu cách) vào SMTP_PASS.
# Để trống thì email OTP chạy dev mode (mã hiện trên toast [DEV]).
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Luméa" <ten@gmail.com>

# SMS (eSMS.vn): đăng ký tài khoản tại https://esms.vn, lấy ApiKey/SecretKey ở mục "Quản lý API".
# Tài khoản dùng thử chỉ gửi được bằng Brandname/mẫu test của eSMS (mặc định bên dưới); khi có
# Brandname riêng thì đổi ESMS_BRANDNAME + ESMS_TEMPLATE ({code} = mã OTP) theo mẫu đã duyệt.
# Để trống thì SMS OTP chạy dev mode.
ESMS_API_KEY=
ESMS_SECRET_KEY=
# ESMS_BRANDNAME=Baotrixemay
# ESMS_TEMPLATE={code} la ma xac minh dang ky Baotrixemay cua ban

# Google OAuth Client ID (Web application) from Google Cloud Console — used to verify
# Google Identity Services ID tokens server-side. No client secret needed for this flow.
# Must match the googleClientId set in the frontend's environment.ts/environment.prod.ts.
GOOGLE_CLIENT_ID=

# Facebook Login — tạo app tại https://developers.facebook.com (thêm sản phẩm "Facebook Login",
# khai báo domain FE). APP_ID phải trùng facebookAppId trong environment.ts của my-client.
# Có APP_SECRET thì server kiểm tra thêm token có đúng được cấp cho app này không (khuyến nghị).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# MoMo sandbox (public test credentials from https://developers.momo.vn/v3/docs/payment/onboarding/test-instructions/)
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:4200/checkout-momo-return
MOMO_IPN_URL=http://localhost:4300/api/payments/momo/ipn

# ZaloPay sandbox (public test credentials from https://docs.zalopay.vn/v2/general/overview.html#zalopay-sandbox)
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=PcY4iZIKFCIdgZvA6ueMcMHHUbRLYjPL
ZALOPAY_KEY2=kLtgPl8HHhfvMuDHPwKfgfsY4Ydm9eIz
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_REDIRECT_URL=http://localhost:4200/checkout-zalopay-return

# Google Gemini API key (free tier) — dùng cho AI Idea Assistant (server/routes/aiRoutes.js,
# gọi từ ai-assistant.service.ts). Lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model dự phòng khi model chính quá tải (503) hoặc hết hạn mức (429).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Tài khoản admin mặc định do server/seed/seed.js tạo (chỉ tạo nếu collection Admin còn trống).
# Đổi trước khi deploy thật — đăng nhập ở my-admin (trang /login).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
